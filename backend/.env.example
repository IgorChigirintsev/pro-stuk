# Скопировать в .env и заполнить. Ключи — только через env, в репозитории их нет.

# Ключ Gemini API (фаза 2; без него /report работает в мок-режиме фазы 1).
GEMINI_API_KEY=

# Модель Gemini. Перед запуском проверить актуальное имя flash-модели.
GEMINI_MODEL=gemini-2.5-flash

PORT=8080

# Бесплатных отчётов на одно устройство в сутки.
DAILY_FREE_LIMIT=3

# Публичный адрес сайта — из него собирается ссылка на APK в /api/v1/version.
PUBLIC_SITE_URL=https://example.kz

# Версия приложения, которую отдаёт /api/v1/version.
LATEST_APP_VERSION=1.0.0

# Домен API для Caddy (авто-TLS), используется в docker-compose (фаза 2).
DOMAIN_API=api.example.kz
