# Скопировать в .env и заполнить. Ключи — только через env, в репозитории их нет.

# Ключ Gemini API. Обязателен: без него сервер не стартует.
GEMINI_API_KEY=

# Модель Gemini. Перед запуском проверить актуальное имя flash-модели.
GEMINI_MODEL=gemini-flash-latest

PORT=8080

# Бесплатных отчётов на одно устройство в сутки.
DAILY_FREE_LIMIT=3

# Публичный адрес сайта — из него собирается ссылка на APK в /api/v1/version.
PUBLIC_SITE_URL=https://example.kz

# Версия приложения, которую отдаёт /api/v1/version.
LATEST_APP_VERSION=1.0.0

# Домен API для Caddy (авто-TLS), используется в docker-compose.
DOMAIN_API=api.example.kz

# TRUST_PROXY=1 — доверять X-Forwarded-For (ставится в docker-compose,
# где api стоит за Caddy). При запуске без прокси не включать.
#TRUST_PROXY=1

# Токен доступа к сводке аналитики сайта (GET /api/v1/stats?token=...).
# Пусто — эндпоинт закрыт. Сгенерировать: openssl rand -hex 24
ANALYTICS_TOKEN=

# Сброс кэша Cloudflare после выкладки: без него HTML живёт на edge до двух
# часов и свежие правки посетитель увидит с задержкой.
# Токен: My Profile → API Tokens → Create Token → Custom token,
# право Zone / Cache Purge / Purge, ресурс — только зона pro-stuk.com.
# ID зоны: страница Overview домена, блок «API» справа внизу.
CF_CACHE_PURGE_TOKEN=
CF_ZONE_ID=

# Вход через Google: идентификатор ВЕБ-клиента OAuth (не Android-клиента).
# console.cloud.google.com → Credentials → OAuth client ID → Web application.
# Приложение передаёт его как serverClientId, сервер сверяет с полем aud.
GOOGLE_CLIENT_ID=

# Вход через Apple: получателем токена выступает bundle id приложения.
APPLE_BUNDLE_ID=chigirintsevandco.prostuk

# Проверка покупок Google Play: файл ключа сервисного аккаунта.
# Play Console → Настройки → Доступ к API. Файл в репозиторий не попадает.
PLAY_SERVICE_ACCOUNT_FILE=play-service-account.json
