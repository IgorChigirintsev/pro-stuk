---
import Base from '../layouts/Base.astro';
import DownloadApk from '../components/DownloadApk.astro';
import { HUBS } from '../data/hubs';
import { SITE_URL, SITE_NAME } from '../../site.config.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  operatingSystem: 'Android',
  applicationCategory: 'UtilitiesApplication',
  description:
    'Диагностика неисправностей автомобиля по симптомам и звуку: опросник, запись звука, отчёт с вероятными причинами.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KZT' },
  url: SITE_URL,
};

const faq = [
  {
    q: 'Это точный диагноз?',
    a: 'Нет. «Стук» даёт вероятностную оценку: список возможных причин с процентами и уровень срочности. Точный диагноз ставит механик после осмотра — отчёт помогает прийти к нему подготовленным.',
  },
  {
    q: 'Сколько это стоит?',
    a: 'Пока бесплатно: до 3 полных отчётов по звуку в день на устройство. Предварительный вердикт по опроснику — без ограничений.',
  },
  {
    q: 'Какие машины поддерживаются?',
    a: 'Легковые автомобили с бензиновым или дизельным двигателем, с механической или автоматической коробкой. Марка, год и пробег учитываются в анализе.',
  },
  {
    q: 'Что происходит с моей записью?',
    a: 'Аудио отправляется на сервер, анализируется и не хранится после анализа. Аккаунтов и рекламных трекеров нет.',
  },
  {
    q: 'А если звук не получится записать?',
    a: 'Отчёт строится в первую очередь на ответах опросника — как у механика, который сначала расспрашивает. Если запись неинформативна, приложение честно скажет об этом.',
  },
];
---

<Base
  title="Стук — диагностика автомобиля по звуку"
  description="Запишите звук — узнайте, что с машиной. Опросник, анализ записи и отчёт: вероятные причины с процентами, светофор срочности и что сказать в сервисе."
  schema={schema}
>
  <!-- Hero -->
  <section class="py-6 text-center sm:py-12">
    <h1 class="mx-auto max-w-2xl text-2xl font-bold sm:text-3xl">
      Запишите звук — узнайте, что с машиной
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-l text-ink-soft">
      Короткий опросник и запись звука 15–30 секунд. В ответ — вероятные причины
      с процентами, светофор срочности и подсказки для разговора в сервисе.
    </p>
    <a
      href="#skachat"
      class="mt-7 inline-block rounded-btn bg-accent px-8 py-4 font-semibold text-white no-underline hover:opacity-90"
    >
      Скачать приложение
    </a>
    <p class="mt-2 text-s text-ink-soft">Android · пока бесплатно</p>
  </section>

  <!-- Как работает: 3 шага с CSS-мокапами -->
  <section class="mt-10">
    <h2 class="text-center text-xl font-bold">Как это работает</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      <!-- Шаг 1: вопросы -->
      <div class="text-center">
        <div class="mx-auto w-40 rounded-card border border-line bg-surface p-3">
          <div class="rounded-field bg-bg p-2 text-left">
            <div class="mb-2 h-2 w-4/5 rounded bg-ink/70"></div>
            <div class="mb-1.5 h-6 rounded-lg border border-line bg-surface"></div>
            <div class="mb-1.5 h-6 rounded-lg border border-line bg-surface"></div>
            <div class="h-6 rounded-lg border border-accent bg-accent-soft"></div>
          </div>
        </div>
        <h3 class="mt-4 font-bold">1. Вопросы</h3>
        <p class="mt-1 text-s text-ink-soft">
          Когда слышен звук и на что похож — дерево вопросов сужает причину.
        </p>
      </div>
      <!-- Шаг 2: звук -->
      <div class="text-center">
        <div class="mx-auto w-40 rounded-card border border-line bg-surface p-3">
          <div class="rounded-field bg-bg p-2">
            <div class="flex h-8 items-center justify-center gap-0.5">
              {[3, 5, 4, 9, 4, 6, 3, 5].map((h) => (
                <span class="w-1 rounded-full bg-accent" style={`height:${h * 3}px`}></span>
              ))}
            </div>
            <div class="mx-auto mt-2 h-9 w-9 rounded-full bg-stop"></div>
          </div>
        </div>
        <h3 class="mt-4 font-bold">2. Звук</h3>
        <p class="mt-1 text-s text-ink-soft">
          Запись 15–30 секунд: спектр, ритм ударов и обороты считаются на сервере.
        </p>
      </div>
      <!-- Шаг 3: отчёт -->
      <div class="text-center">
        <div class="mx-auto w-40 rounded-card border border-line bg-surface p-3">
          <div class="rounded-field bg-bg p-2 text-left">
            <div class="mb-2 rounded-lg bg-warn p-1.5">
              <div class="h-2 w-3/5 rounded bg-white/90"></div>
            </div>
            <div class="mb-1 h-1.5 w-full rounded bg-accent-soft">
              <div class="h-1.5 w-3/5 rounded bg-accent"></div>
            </div>
            <div class="mb-1 h-1.5 w-full rounded bg-accent-soft">
              <div class="h-1.5 w-2/5 rounded bg-accent"></div>
            </div>
            <div class="h-1.5 w-full rounded bg-accent-soft">
              <div class="h-1.5 w-1/5 rounded bg-accent"></div>
            </div>
          </div>
        </div>
        <h3 class="mt-4 font-bold">3. Отчёт</h3>
        <p class="mt-1 text-s text-ink-soft">
          Причины с процентами, светофор срочности и что сказать в сервисе.
        </p>
      </div>
    </div>
  </section>

  <!-- Скачивание APK -->
  <div class="mt-14">
    <DownloadApk />
  </div>

  <!-- FAQ -->
  <section class="mt-14">
    <h2 class="text-xl font-bold">Частые вопросы</h2>
    <div class="mt-4 space-y-4">
      {faq.map((f) => (
        <details class="rounded-card border border-line bg-surface p-4">
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-2 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Разделы по узлам -->
  <section class="mt-14">
    <h2 class="text-center text-xl font-bold">Разборы по узлам</h2>
    <ul class="mx-auto mt-6 grid max-w-3xl gap-3 sm:grid-cols-2">
      {HUBS.map((h) => (
        <li>
          <a
            href={`/uzly/${h.slug}/`}
            class="flex h-full items-center gap-4 rounded-card border border-line bg-surface p-4 no-underline hover:border-accent"
          >
            <img src={`/uzly/${h.slug}.svg`} alt="" width="96" height="58" class="hidden shrink-0 rounded-lg sm:block" />
            <span>
            <span class="font-semibold text-ink">{h.h1}</span>
            <span class="mt-1 block text-s text-ink-soft">{h.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Симптомы -->
  <section class="mt-14 text-center">
    <h2 class="text-xl font-bold">Разборы по симптомам</h2>
    <p class="mx-auto mt-2 max-w-xl text-ink-soft">
      Стук в двигателе, гул при движении, скрип тормозов — что это значит
      и насколько срочно.
    </p>
    <a href="/simptomy/" class="mt-4 inline-block font-semibold text-accent no-underline hover:underline">
      Все симптомы →
    </a>
  </section>
</Base>
