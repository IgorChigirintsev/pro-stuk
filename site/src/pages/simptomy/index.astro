---
import Base from '../../layouts/Base.astro';
import { SYMPTOMS, GROUPS } from '../../data/types';

const order: (keyof typeof GROUPS)[] = ['dvigatel', 'dvizhenie', 'tormoza-rul', 'podveska'];
---

<Base
  title="Звуки и симптомы неисправностей автомобиля — разборы | Стук"
  description="Стук, гул, визг, скрежет: что означает каждый звук автомобиля, насколько это опасно и что проверить самому. Разборы по симптомам с деревом диагностики."
>
  <h1 class="text-2xl font-bold sm:text-3xl">Симптомы по звуку</h1>
  <p class="mt-4 max-w-2xl text-ink-soft">
    Выберите звук, похожий на ваш. В каждом разборе — вероятные причины,
    светофор опасности, безопасные самопроверки и интерактивное дерево диагностики.
  </p>

  {order.map((g) => (
    <section class="mt-10">
      <h2 class="text-xl font-bold">{GROUPS[g]}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {SYMPTOMS.filter((s) => s.group === g).map((s) => (
          <li>
            <a
              href={`/simptomy/${s.slug}/`}
              class="block min-h-14 rounded-card border border-line bg-surface px-4 py-3 text-ink no-underline hover:border-accent"
            >
              {s.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
