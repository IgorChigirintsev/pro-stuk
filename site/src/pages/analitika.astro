---
import Base from '../layouts/Base.astro';
import { API_URL } from '../../site.config.mjs';
---

<Base title="Аналитика | Стук" description="Служебная страница.">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <h1 class="text-2xl font-bold">Аналитика</h1>
  <p class="mt-2 text-s text-ink-soft">
    Обезличенные просмотры страниц. Машина владельца не учитывается.
  </p>

  <div id="stats-root" class="mt-8">
    <p class="text-ink-soft">Загрузка…</p>
  </div>
</Base>

<script is:inline define:vars={{ apiUrl: API_URL }}>
  (async () => {
    const KEY = 'stuk_admin_token';

    // Активация по секретной ссылке: /analitika/#key=<токен>
    if (location.hash.startsWith('#key=')) {
      localStorage.setItem(KEY, location.hash.slice(5));
      history.replaceState(null, '', location.pathname);
    }

    const root = document.getElementById('stats-root');
    const token = localStorage.getItem(KEY);
    if (!token) {
      root.innerHTML = '<p>Нет доступа.</p>';
      return;
    }

    let data;
    try {
      const resp = await fetch(apiUrl + '/api/v1/stats?token=' + encodeURIComponent(token));
      if (!resp.ok) throw new Error(String(resp.status));
      data = await resp.json();
    } catch (e) {
      root.innerHTML =
        '<p>Не удалось загрузить данные' +
        (String(e.message) === '403' ? ': ключ не подошёл.' : '. Попробуйте обновить страницу.') +
        '</p>';
      if (String(e.message) === '403') localStorage.removeItem(KEY);
      return;
    }

    const periods = [
      ['today', 'Сегодня'],
      ['yesterday', 'Вчера'],
      ['week', '7 дней'],
      ['days28', '28 дней'],
    ];

    const esc = (s) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Сводные карточки
    const cards = periods
      .map(
        ([k, label]) => `
        <div class="rounded-card border border-line bg-surface p-4 text-center">
          <div class="text-2xl font-bold tnum">${data[k].total}</div>
          <div class="mt-1 text-s text-ink-soft">${label}</div>
        </div>`
      )
      .join('');

    // Таблица по страницам, сортировка по 28 дням
    const pages = Object.keys(data.days28.pages).sort(
      (a, b) => data.days28.pages[b] - data.days28.pages[a]
    );
    const rows = pages
      .map((p) => {
        const cells = periods
          .map(([k]) => `<td class="p-3 text-right tnum">${data[k].pages[p] || 0}</td>`)
          .join('');
        return `<tr class="border-t border-line">
          <td class="p-3 break-all">${esc(p)}</td>${cells}</tr>`;
      })
      .join('');

    const bots = periods
      .map(([k, label]) => `${label.toLowerCase()}: ${data[k].bots || 0}`)
      .join(' · ');

    root.innerHTML = `
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">${cards}</div>
      <p class="mt-3 text-s text-ink-soft">Отфильтровано ботов — ${bots}</p>
      <h2 class="mt-10 text-xl font-bold">По страницам</h2>
      ${
        pages.length === 0
          ? '<p class="mt-3 text-ink-soft">Пока пусто — просмотры появятся после первых посетителей.</p>'
          : `<div class="mt-4 overflow-x-auto rounded-card border border-line">
              <table class="w-full border-collapse text-left text-s">
                <thead><tr class="bg-surface text-ink-soft">
                  <th class="p-3 font-semibold">Страница</th>
                  <th class="p-3 text-right font-semibold">Сегодня</th>
                  <th class="p-3 text-right font-semibold">Вчера</th>
                  <th class="p-3 text-right font-semibold">7 дней</th>
                  <th class="p-3 text-right font-semibold">28 дней</th>
                </tr></thead>
                <tbody>${rows}</tbody>
              </table>
            </div>`
      }`;
  })();
</script>
