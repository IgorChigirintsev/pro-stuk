---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppCtaCard from '../../components/AppCtaCard.astro';
import { HUBS, hubForArticle } from '../../data/hubs';
import { SYMPTOMS } from '../../data/types';
import { SITE_URL } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return HUBS.map((hub) => ({
    params: { slug: hub.slug },
    props: {
      hub,
      articles: articles
        .filter((a) => hubForArticle(a.id).slug === hub.slug)
        .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru')),
    },
  }));
}

const { hub, articles } = Astro.props;
const symptomPages = hub.symptoms
  .map((s) => SYMPTOMS.find((x) => x.slug === s))
  .filter(Boolean);

const canonical = `${SITE_URL}/uzly/${hub.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.h1,
    description: hub.description,
    url: canonical,
    inLanguage: 'ru',
    hasPart: articles.slice(0, 50).map((a) => ({
      '@type': 'Article',
      headline: a.data.title,
      url: `${SITE_URL}/stati/${a.id}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Стук', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Разделы', item: `${SITE_URL}/stati/` },
      { '@type': 'ListItem', position: 3, name: hub.short, item: canonical },
    ],
  },
];
---

<Base title={hub.metaTitle} description={hub.description} schema={schema} wide>
  <div class="lg:grid lg:grid-cols-[minmax(0,50rem)_18rem] lg:justify-center lg:gap-8">
    <div>
      <nav class="text-s text-ink-soft" aria-label="Хлебные крошки">
        <a href="/" class="no-underline hover:text-accent">Стук</a> ·
        <a href="/stati/" class="no-underline hover:text-accent">Статьи</a>
      </nav>

      <h1 class="mt-3 text-2xl font-bold sm:text-3xl">{hub.h1}</h1>
      <p class="mt-2 text-s text-ink-soft">
        {articles.length} разборов в разделе
      </p>

      {hub.intro.map((p) => <p class="mt-4 text-ink-soft">{p}</p>)}

      {symptomPages.length > 0 && (
        <>
          <h2 class="mt-10 text-xl font-bold">Определить звук по вопросам</h2>
          <p class="mt-2 text-ink-soft">
            Интерактивное дерево диагностики: несколько вопросов — и круг причин сужается.
          </p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {symptomPages.map((s) => (
              <li>
                <a
                  href={`/simptomy/${s!.slug}/`}
                  class="block h-full rounded-card border border-line bg-surface p-4 text-ink no-underline hover:border-accent"
                >
                  {s!.h1}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      <h2 class="mt-10 text-xl font-bold">Все статьи раздела</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {articles.map((a) => (
          <li>
            <a
              href={`/stati/${a.id}/`}
              class="block h-full rounded-card border border-line bg-surface p-4 no-underline hover:border-accent"
            >
              <span class="font-semibold text-ink">{a.data.title}</span>
              <span class="mt-1 block text-s text-ink-soft">{a.data.description}</span>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-10 text-xl font-bold">Другие разделы</h2>
      <nav class="mt-4 flex flex-wrap gap-3 text-s">
        {HUBS.filter((h) => h.slug !== hub.slug).map((h) => (
          <a
            href={`/uzly/${h.slug}/`}
            class="rounded-btn border border-line bg-surface px-3 py-2 text-accent no-underline hover:border-accent"
          >
            {h.short}
          </a>
        ))}
      </nav>

      <div class="mt-12 lg:hidden">
        <AppCtaCard />
      </div>
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-6">
        <AppCtaCard />
      </div>
    </aside>
  </div>
</Base>
