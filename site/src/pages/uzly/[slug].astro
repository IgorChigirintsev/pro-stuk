---
import { getCollection } from 'astro:content';

import Hub from '../../components/pages/Hub.astro';
import { v } from '../../data/assetVersion';
import { HUBS, hubForArticle } from '../../data/hubs';
import { hubEn } from '../../data/hubs_en';
import { hubsBase } from '../../i18n/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const en = await getCollection('articlesEn');
  return HUBS.map((hub) => ({
    params: { slug: hub.slug },
    props: {
      hub,
      articles: articles
        .filter((a) => hubForArticle(a.id).slug === hub.slug)
        .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'))
        .map((a) => ({ slug: a.id, title: a.data.title, description: a.data.description })),
      // Английский раздел показываем в hreflang, только когда в нём есть статьи.
      hasEn: en.some((a) => hubForArticle(a.data.ru).slug === hub.slug),
    },
  }));
}

const { hub, articles, hasEn } = Astro.props;
const alts = hasEn
  ? {
      ru: `${hubsBase('ru')}/${hub.slug}/`,
      en: `${hubsBase('en')}/${hubEn(hub).slug}/`,
    }
  : null;
---

<Hub
  lang="ru"
  ruSlug={hub.slug}
  articles={articles}
  alts={alts}
  ogImage={v(`/og/${hub.slug}.png`)}
/>
