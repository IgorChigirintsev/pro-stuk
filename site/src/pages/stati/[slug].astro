---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppCtaCard from '../../components/AppCtaCard.astro';
import { hubForArticle } from '../../data/hubs';
import { SITE_URL } from '../../../site.config.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const byId = new Map(articles.map((a) => [a.id, a]));
  // Битые related-слаги ломают билд, а не молча пропадают.
  for (const a of articles) {
    for (const r of a.data.related) {
      if (!byId.has(r)) {
        throw new Error(`Статья «${a.id}»: related-слаг «${r}» не существует`);
      }
    }
  }
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles },
  }));
}

const { article, all } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);

const byId = new Map(all.map((a) => [a.id, a]));
const related = article.data.related
  .map((id) => byId.get(id))
  .filter(Boolean)
  .slice(0, 4);

function fmtDate(iso: string) {
  const months = [
    'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
    'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
  ];
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${months[(m ?? 1) - 1]} ${y}`;
}

const hub = hubForArticle(article.id);
const canonical = `${SITE_URL}/stati/${article.id}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.pubDate,
    dateModified: article.data.updated ?? article.data.pubDate,
    mainEntityOfPage: canonical,
    inLanguage: 'ru',
    author: { '@type': 'Organization', name: 'Стук', url: SITE_URL },
    publisher: { '@type': 'Organization', name: 'Стук', url: SITE_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Стук', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${SITE_URL}/stati/` },
      { '@type': 'ListItem', position: 3, name: hub.short, item: `${SITE_URL}/uzly/${hub.slug}/` },
      { '@type': 'ListItem', position: 4, name: article.data.title, item: canonical },
    ],
  },
];
---

<Base title={article.data.metaTitle} description={article.data.description} schema={schema} wide>
  <div class="lg:grid lg:grid-cols-[16rem_minmax(0,42rem)_18rem] lg:justify-center lg:gap-8">
    <!-- Слева: похожие статьи (липкая, только desktop) -->
    <aside class="hidden lg:block">
      {related.length > 0 && (
        <div class="sticky top-6 rounded-card border border-line bg-surface p-5">
          <p class="font-bold">Похожие статьи</p>
          <ul class="mt-3 space-y-3">
            {related.map((r) => (
              <li>
                <a href={`/stati/${r!.id}/`} class="text-s text-accent no-underline hover:underline">
                  {r!.data.title}
                </a>
              </li>
            ))}
          </ul>
          <a href={`/uzly/${hub.slug}/`} class="mt-4 block text-s text-accent no-underline hover:underline">
            Все о разделе «{hub.short}» →
          </a>
          <a href="/stati/" class="mt-2 block text-s text-ink-soft no-underline hover:text-accent">
            Все статьи →
          </a>
        </div>
      )}
    </aside>

    <!-- Центр: статья -->
    <article>
      <nav class="text-s text-ink-soft" aria-label="Хлебные крошки">
        <a href="/" class="no-underline hover:text-accent">Стук</a> ·
        <a href="/stati/" class="no-underline hover:text-accent">Статьи</a> ·
        <a href={`/uzly/${hub.slug}/`} class="no-underline hover:text-accent">{hub.short}</a>
      </nav>

      <h1 class="mt-3 text-2xl font-bold sm:text-3xl">{article.data.title}</h1>
      <p class="mt-2 text-s text-ink-soft">
        Обновлено {fmtDate(article.data.updated ?? article.data.pubDate)}
      </p>

      {toc.length > 1 && (
        <nav class="mt-6 rounded-card border border-line bg-surface p-5" aria-label="Содержание">
          <p class="font-bold">Содержание</p>
          <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-s">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-accent no-underline hover:underline">{h.text}</a>
              </li>
            ))}
            {article.data.faq.length > 0 && (
              <li><a href="#faq" class="text-accent no-underline hover:underline">Частые вопросы</a></li>
            )}
          </ol>
        </nav>
      )}

      <div class="article-body">
        <Content />
      </div>

      <h2 id="faq" class="mt-10 text-xl font-bold" style="scroll-margin-top:1rem">Частые вопросы</h2>
      <div class="mt-4 space-y-4">
        {article.data.faq.map((f) => (
          <details class="rounded-card border border-line bg-surface p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>

      {article.data.sources.length > 0 && (
        <>
          <h2 class="mt-10 text-xl font-bold">Источники</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-s">
            {article.data.sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener" target="_blank" class="text-accent">
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </article>

    <!-- Справа: CTA приложения (липкая, только desktop) -->
    <aside class="hidden lg:block">
      <div class="sticky top-6">
        <AppCtaCard />
      </div>
    </aside>
  </div>

  <!-- Мобильная версия карточек: после статьи -->
  <div class="mt-10 space-y-6 lg:hidden">
    <AppCtaCard />
    {related.length > 0 && (
      <div class="rounded-card border border-line bg-surface p-5">
        <p class="font-bold">Похожие статьи</p>
        <ul class="mt-3 space-y-3">
          {related.map((r) => (
            <li>
              <a href={`/stati/${r!.id}/`} class="text-accent no-underline hover:underline">
                {r!.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Base>
