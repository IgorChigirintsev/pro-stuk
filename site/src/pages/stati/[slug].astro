---
import { getCollection, render } from 'astro:content';

import Article from '../../components/pages/Article.astro';
import { v } from '../../data/assetVersion';
import { articleAlts, langsBySlug } from '../../i18n/altMaps';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const byId = new Map(articles.map((a) => [a.id, a]));
  // Битые related-слаги ломают билд, а не молча пропадают.
  for (const a of articles) {
    for (const r of a.data.related) {
      if (!byId.has(r)) {
        throw new Error(`Статья «${a.id}»: related-слаг «${r}» не существует`);
      }
    }
  }
  const en = await getCollection('articlesEn');
  const enByRu = new Map(en.map((a) => [a.data.ru, a.id]));
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles, enSlug: enByRu.get(article.id) ?? null },
  }));
}

const { article, all, enSlug } = Astro.props;
const { Content, headings } = await render(article);

const byId = new Map(all.map((a) => [a.id, a]));
const related = article.data.related
  .map((id) => byId.get(id))
  .filter(Boolean)
  .slice(0, 4)
  .map((r) => ({ title: r!.data.title, href: `/stati/${r!.id}/` }));

// Все языки, на которые статья переведена: hreflang должен подтверждаться
// с обеих сторон, иначе Google отбрасывает связку целиком.
const alts = enSlug ? articleAlts(enSlug, article.id, (await langsBySlug()).get(enSlug) ?? []) : null;
---

<Article
  lang="ru"
  slug={article.id}
  ruSlug={article.id}
  data={article.data}
  headings={headings}
  related={related}
  alts={alts}
  ogImage={v(`/og/stati/${article.id}.png`)}
>
  <Content />
</Article>
