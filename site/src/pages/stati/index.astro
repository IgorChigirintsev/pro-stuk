---
import { getCollection } from 'astro:content';

import ArticleIndex from '../../components/pages/ArticleIndex.astro';
import { articlesBase } from '../../i18n/articles';

const articles = await getCollection('articles');
const items = articles.map((a) => ({
  slug: a.id,
  ruSlug: a.id,
  title: a.data.title,
  description: a.data.description,
  date: a.data.updated ?? a.data.pubDate,
}));

// Английский список появляется в hreflang только когда там есть статьи.
const en = await getCollection('articlesEn');
const alts = en.length ? { ru: '/stati/', en: `${articlesBase('en')}/` } : null;
---

<ArticleIndex lang="ru" items={items} alts={alts} />
