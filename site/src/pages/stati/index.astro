---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { HUBS, hubForArticle } from '../../data/hubs';
import { SITE_URL } from '../../../site.config.mjs';

const articles = (await getCollection('articles')).sort((a, b) =>
  (b.data.updated ?? b.data.pubDate).localeCompare(a.data.updated ?? a.data.pubDate)
);

const grouped = HUBS.map((h) => ({
  hub: h,
  items: articles.filter((a) => hubForArticle(a.id).slug === h.slug),
})).filter((g) => g.items.length > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Статьи о звуках и неисправностях автомобиля',
  url: `${SITE_URL}/stati/`,
  inLanguage: 'ru',
  hasPart: HUBS.map((h) => ({
    '@type': 'CollectionPage',
    name: h.h1,
    url: `${SITE_URL}/uzly/${h.slug}/`,
  })),
};

function fmtDate(iso: string) {
  const months = [
    'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
    'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
  ];
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${months[(m ?? 1) - 1]} ${y}`;
}
---

<Base
  title="Статьи о звуках и неисправностях автомобиля | Стук"
  description="Разборы автомобильных звуков и неисправностей: признаки износа узлов, можно ли ехать, как проверить самому. Практичные статьи без воды."
  schema={schema}
>
  <h1 class="text-2xl font-bold sm:text-3xl">Статьи</h1>
  <p class="mt-4 max-w-2xl text-ink-soft">
    Практичные разборы: как звучат неисправности, насколько это срочно
    и что можно проверить самому до сервиса.
  </p>

  <nav class="mt-6 flex flex-wrap gap-3 text-s" aria-label="Разделы">
    {grouped.map((g) => (
      <a href={`/uzly/${g.hub.slug}/`} class="rounded-btn border border-line bg-surface px-3 py-2 text-accent no-underline hover:border-accent">
        {g.hub.short} <span class="tnum text-ink-soft">{g.items.length}</span>
      </a>
    ))}
  </nav>

  {grouped.map((g) => (
    <section class="mt-10">
      <h2 class="text-xl font-bold">
        <a href={`/uzly/${g.hub.slug}/`} class="text-ink no-underline hover:text-accent">{g.hub.short}</a>
      </h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {g.items.map((a) => (
          <li>
            <a
              href={`/stati/${a.id}/`}
              class="block h-full rounded-card border border-line bg-surface p-5 no-underline hover:border-accent"
            >
              <p class="font-bold text-l text-ink">{a.data.title}</p>
              <p class="mt-2 text-s text-ink-soft">{a.data.description}</p>
              <p class="mt-3 text-s text-ink-soft">{fmtDate(a.data.updated ?? a.data.pubDate)}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
