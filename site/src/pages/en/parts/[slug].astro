---
import { getCollection } from 'astro:content';

import Hub from '../../../components/pages/Hub.astro';
import { v } from '../../../data/assetVersion';
import { HUBS, hubForArticle } from '../../../data/hubs';
import { hubEn } from '../../../data/hubs_en';
import { hubsBase } from '../../../i18n/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articlesEn');
  // Пустой раздел не показываем: страница без статей не нужна ни читателю,
  // ни поиску. Появится сама, как только в разделе переведут первую статью.
  return HUBS.filter((hub) =>
    articles.some((a) => hubForArticle(a.data.ru).slug === hub.slug)
  ).map((hub) => ({
    params: { slug: hubEn(hub).slug },
    props: {
      ruSlug: hub.slug,
      otherHubs: HUBS.filter((h) =>
        articles.some((a) => hubForArticle(a.data.ru).slug === h.slug)
      ).map((h) => h.slug),
      articles: articles
        .filter((a) => hubForArticle(a.data.ru).slug === hub.slug)
        .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'))
        .map((a) => ({ slug: a.id, title: a.data.title, description: a.data.description })),
    },
  }));
}

const { ruSlug, articles, otherHubs } = Astro.props;
const hub = HUBS.find((h) => h.slug === ruSlug)!;
const alts = {
  ru: `${hubsBase('ru')}/${ruSlug}/`,
  en: `${hubsBase('en')}/${hubEn(hub).slug}/`,
};
---

<Hub lang="en" ruSlug={ruSlug} articles={articles} alts={alts} otherHubs={otherHubs} ogImage={v(`/og/en/parts/${hubEn(hub).slug}.png`)} />
