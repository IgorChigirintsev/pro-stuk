---
import { getCollection } from 'astro:content';

import { articleIndexAlts, langsWithArticles } from '../../../i18n/altMaps';
import ArticleIndex from '../../../components/pages/ArticleIndex.astro';

const articles = await getCollection('articlesEn');
const items = articles.map((a) => ({
  slug: a.id,
  ruSlug: a.data.ru,
  title: a.data.title,
  description: a.data.description,
  date: a.data.updated ?? a.data.pubDate,
}));

const alts = articleIndexAlts(await langsWithArticles());
---

<ArticleIndex lang="en" items={items} alts={alts} />
