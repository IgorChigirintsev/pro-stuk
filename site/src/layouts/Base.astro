---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, API_URL } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  /** Дополнительный JSON-LD (уже сериализованный объект). */
  schema?: object;
  /** Широкий контейнер (статьи с боковыми карточками). */
  wide?: boolean;
}

const { title, description, schema, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon.png', SITE_URL).href} />
    <meta property="og:locale" content="ru_RU" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink text-base">
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-4xl items-center gap-6 px-5 py-4">
        <a href="/" class="flex items-center gap-2 font-bold text-l text-ink no-underline">
          <img src="/icon.png" alt="" width="28" height="28" class="rounded-lg" />
          {SITE_NAME}
        </a>
        <div class="ml-auto flex items-center gap-5 text-s" data-nav>
          <a href="/simptomy/" class="text-ink-soft hover:text-accent">Симптомы</a>
          <a href="/kak-eto-rabotaet/" class="text-ink-soft hover:text-accent">Методика</a>
          <a
            href="/stati/"
            class="text-ink-soft hover:text-accent"
            aria-label="Статьи"
            title="Статьи"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
              <path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class={`mx-auto px-5 py-10 ${wide ? 'max-w-7xl' : 'max-w-4xl'}`}>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-4xl px-5 py-8 text-s text-ink-soft">
        <p class="mb-3">
          «{SITE_NAME}» даёт вероятностную оценку по симптомам и звуку, а не диагноз.
          Итоговое решение о ремонте принимает механик после осмотра автомобиля.
        </p>
        <p class="flex flex-wrap gap-4">
          <a href="/kak-eto-rabotaet/" class="hover:text-accent">Как это работает</a>
          <a href="/politika/" class="hover:text-accent">Политика конфиденциальности</a>
        </p>
      </div>
    </footer>
    <script is:inline define:vars={{ apiUrl: API_URL }}>
      // Обезличенный счётчик просмотров: без cookies и идентификаторов.
      // Машина владельца (с сохранённым ключом аналитики) не учитывается,
      // вместо этого ей показывается кнопка «Аналитика».
      (() => {
        const token = localStorage.getItem('stuk_admin_token');
        if (token) {
          const nav = document.querySelector('[data-nav]');
          if (nav && !nav.querySelector('[data-analytics]')) {
            const a = document.createElement('a');
            a.href = '/analitika/';
            a.textContent = 'Аналитика';
            a.className = 'text-accent hover:underline';
            a.setAttribute('data-analytics', '');
            nav.appendChild(a);
          }
        } else if (!location.pathname.startsWith('/analitika') && !navigator.webdriver) {
          try {
            navigator.sendBeacon(apiUrl + '/api/v1/hit', location.pathname);
          } catch {}
        }
      })();
    </script>
  </body>
</html>
