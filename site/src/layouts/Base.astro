---
import '../styles/global.css';
import { v } from '../data/assetVersion';
import { SITE_URL, API_URL } from '../../site.config.mjs';
import {
  COUNTRY_TO_LANG,
  DEFAULT_LANG,
  LANGS,
  LANG_NAMES,
  OG_LOCALE,
  RTL,
  altsFor,
  pathFor,
  symptomAlts,
  symptomPath,
  t,
  type PageId,
} from '../i18n';
import { hasSymptoms } from '../data/types';
import { ARTICLE_UI, articlesBase } from '../i18n/articles';

interface Props {
  title: string;
  description: string;
  /** Дополнительный JSON-LD (уже сериализованный объект). */
  schema?: object;
  /** Широкий контейнер (статьи с боковыми карточками). */
  wide?: boolean;
  /** Даты статьи в ISO. Заданы — страница объявляется og:type=article
   *  и отдаёт соцсетям даты публикации и правки. */
  published?: string;
  modified?: string;
  /** Картинка для соцсетей (абсолютный путь от корня сайта).
   *  Не задана — берём картинку языка страницы: превью ссылки человек видит
   *  раньше сайта, и надпись в нём должна быть на его языке. */
  ogImage?: string;
  /** Язык страницы. По умолчанию русский: на нём весь исходный контент. */
  lang?: string;
  /** Идентификатор страницы для hreflang и переключателя языка.
   *  Не задан — значит переводов у страницы нет (статьи, разборы по узлам). */
  page?: PageId;
  /** Разбор симптома: адреса у него свои на каждом языке. */
  symptomSlug?: string;
  /** Готовая карта «язык → адрес» для страниц со своими правилами адресов
   *  (статьи и разделы по узлам: слаги там переводятся вместе с текстом). */
  alts?: Record<string, string> | null;
}

const {
  title,
  description,
  schema,
  wide = false,
  ogImage,
  lang = DEFAULT_LANG,
  page,
  symptomSlug,
  alts: altsProp,
  published,
  modified,
} = Astro.props;

const og = ogImage ?? v(`/og/${lang}.png`);
const d = t(lang);
/** Статьи есть по-русски (оригинал) и по-английски (pSEO); остальным языкам
 *  показывать вкладку нечего. */
const hasArticles = ARTICLE_UI[lang] !== undefined;
const isRu = lang === DEFAULT_LANG;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

/** Какой файл шрифта предзагрузить. Русский тянет кириллический набор,
 *  латинописьменные — латинский. У китайского, японского, корейского и
 *  арабского в Manrope нет ни одного нужного символа, и предзагрузка была бы
 *  чистой тратой трафика на самом медленном месте загрузки. */
const preloadFont = ['zh', 'ja', 'ko', 'ar'].includes(lang)
  ? null
  : lang === 'ru'
    ? '/fonts/manrope-cyrillic.woff2'
    : '/fonts/manrope-latin.woff2';
// Есть перевод — есть и альтернативы; у статьи их нет, и трогать её нельзя.
const alts = altsProp ?? (symptomSlug ? symptomAlts(symptomSlug) : page ? altsFor(page) : null);
const langHref = (l: string) => alts?.[l] ?? pathFor('home', l);
---

<!doctype html>
<html lang={lang} dir={RTL.includes(lang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /* Перечисляем только те языки, где страница действительно есть:
         разбор симптома живёт лишь на переведённых языках. */
      alts && (
        <>
          {Object.entries(alts).map(([l, href]) => (
            <link rel="alternate" hreflang={l} href={new URL(href, SITE_URL).href} />
          ))}
          {alts.en && (
            <link rel="alternate" hreflang="x-default" href={new URL(alts.en, SITE_URL).href} />
          )}
        </>
      )
    }
    <!-- Предзагрузка шрифта: без неё браузер узнаёт о нём только после разбора
         CSS, и текст успевает мигнуть системным начертанием. Файл выбираем по
         языку — на китайской, японской, корейской и арабской странице Manrope
         не нужен вовсе, там работают системные шрифты. -->
    {
      preloadFont && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={preloadFont}
          crossorigin="anonymous"
        />
      )
    }
    <!-- /favicon.ico и /apple-touch-icon.png роботы запрашивают сами, даже если не объявлены:
         без файлов это давало 404 в отчёте Search Console. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e7c7b" />
    <!-- Полный сниппет и крупная картинка в выдаче: без этого Google сам режет
         описание и показывает миниатюру. -->
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {
      published && (
        <>
          <meta property="article:published_time" content={published} />
          <meta property="article:modified_time" content={modified ?? published} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={OG_LOCALE[lang] ?? OG_LOCALE.en} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {
      alts && (
        <script
          is:inline
          define:vars={{ pageLang: lang, alts, c2l: COUNTRY_TO_LANG, known: LANGS }}
        >
          // Язык подбирается так же, как в приложении: язык браузера, затем
          // ближайший язык по стране, затем английский. Уходим на другую версию
          // только до первого осознанного выбора — выбранный язык живёт в
          // localStorage и больше не переспрашивается.
          (() => {
            const saved = localStorage.getItem('stuk_lang');
            if (saved) {
              if (saved !== pageLang && alts[saved]) location.replace(alts[saved]);
              return;
            }
            // Поисковых роботов не перебрасываем: иначе русская версия рискует
            // выпасть из индекса в пользу английской.
            // «google» и «bing» целиком не берём: они попадаются и в браузерах
            // обычных телефонов, а лишить человека перевода хуже, чем недосчитаться
            // редкого робота.
            if (/bot|crawl|spider|slurp|yandex|duckduck|facebookexternalhit/i.test(navigator.userAgent))
              return;

            const pick = () => {
              for (const tag of navigator.languages || [navigator.language || '']) {
                const [base, region] = tag.toLowerCase().split('-');
                if (known.includes(base)) return base;
                const byCountry = region && c2l[region.toUpperCase()];
                if (byCountry) return byCountry;
              }
              return 'en';
            };
            const want = pick();
            if (want !== pageLang && alts[want]) location.replace(alts[want]);
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink text-base">
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-4xl items-center gap-6 px-5 py-4">
        <a
          href={pathFor('home', lang)}
          class="flex items-center gap-2 font-bold text-l text-ink no-underline"
        >
          <img src="/icon-96.png" alt="" width="28" height="28" class="rounded-lg" />
          {d.brand}
        </a>
        <!-- Иконки навигации: подписи в title и aria-label -->
        <div class="ml-auto flex items-center gap-4" data-nav>
          {
            hasSymptoms(lang) && (
              <a
                href={symptomPath(null, lang)}
                class="p-1 text-ink-soft hover:text-accent"
                aria-label={d.nav.symptoms}
                title={d.nav.symptoms}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M11 2v2"/><path d="M5 2v2"/>
                  <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
                  <path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>
                </svg>
              </a>
            )
          }
          <a
            href={pathFor('how', lang)}
            class="p-1 text-ink-soft hover:text-accent"
            aria-label={d.nav.how}
            title={d.nav.how}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M12 7v14"/>
              <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
            </svg>
          </a>
          {
            hasArticles && (
              <a
                href={articlesBase(lang) + '/'}
                class="p-1 text-ink-soft hover:text-accent"
                aria-label={d.nav.articles}
                title={d.nav.articles}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                  <path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
                </svg>
              </a>
            )
          }
          <!-- Переключатель языка: список на самих языках, без флагов —
               флаг обозначает страну, а не язык, и путает больше, чем помогает. -->
          <details class="relative" data-lang-switch>
            <summary
              class="flex cursor-pointer list-none items-center gap-1 p-1 text-ink-soft hover:text-accent"
              aria-label={d.nav.lang}
              title={d.nav.lang}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <span class="text-s uppercase">{lang}</span>
            </summary>
            <ul
              class="absolute end-0 z-10 mt-2 max-h-80 w-44 overflow-y-auto rounded-card border border-line bg-surface py-1 shadow-lg"
            >
              {
                LANGS.map((l) => (
                  <li>
                    <a
                      href={langHref(l)}
                      data-lang={l}
                      hreflang={l}
                      class:list={[
                        'block px-4 py-2 text-s no-underline hover:bg-accent-soft',
                        l === lang ? 'font-bold text-accent' : 'text-ink',
                      ]}
                    >
                      {LANG_NAMES[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </nav>
    </header>

    <main class={`mx-auto px-5 py-10 ${wide ? 'max-w-7xl' : 'max-w-4xl'}`}>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-4xl px-5 py-8 text-s text-ink-soft">
        <p class="mb-3">{d.footer.disclaimer}</p>
        <p class="flex flex-wrap gap-4">
          <a href={pathFor('how', lang)} class="hover:text-accent">{d.footer.how}</a>
          <a href={pathFor('privacy', lang)} class="hover:text-accent">{d.footer.privacy}</a>
          {
            /* Есть свои статьи — ведём в них. Нет — честно говорим, что раздел
               русский, вместо того чтобы молча уводить на непонятный язык. */
            hasArticles && !isRu && (
              <a href={articlesBase(lang) + '/'} class="hover:text-accent">{d.nav.articles}</a>
            )
          }
          {
            !isRu && !hasArticles && (
              <a href="/simptomy/" class="hover:text-accent" hreflang="ru" lang="ru">
                {hasSymptoms(lang) ? d.footer.ruArticles : d.footer.ruOnly}
              </a>
            )
          }
        </p>
      </div>
    </footer>
    <script is:inline>
      // Выбор языка руками сильнее автоопределения и переживает перезаход.
      document.addEventListener('click', (e) => {
        const a = e.target instanceof Element ? e.target.closest('a[data-lang]') : null;
        if (a) localStorage.setItem('stuk_lang', a.getAttribute('data-lang'));
      });
      // Меню закрывается по клику мимо и по Esc — иначе висит поверх страницы.
      document.addEventListener('click', (e) => {
        for (const el of document.querySelectorAll('[data-lang-switch][open]')) {
          if (!el.contains(e.target)) el.removeAttribute('open');
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        for (const el of document.querySelectorAll('[data-lang-switch][open]')) {
          el.removeAttribute('open');
        }
      });
    </script>
    <script is:inline define:vars={{ apiUrl: API_URL, analyticsLabel: d.nav.analytics }}>
      // Обезличенный счётчик просмотров: без cookies и идентификаторов.
      // Машина владельца (с сохранённым ключом аналитики) не учитывается,
      // вместо этого ей показывается кнопка «Аналитика».
      (() => {
        const token = localStorage.getItem('stuk_admin_token');
        if (token) {
          const nav = document.querySelector('[data-nav]');
          if (nav && !nav.querySelector('[data-analytics]')) {
            const a = document.createElement('a');
            a.href = '/analitika/';
            a.className = 'p-1 text-accent hover:opacity-80';
            a.setAttribute('data-analytics', '');
            a.setAttribute('aria-label', analyticsLabel);
            a.setAttribute('title', analyticsLabel);
            a.innerHTML =
              '<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" ' +
              'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' +
              'stroke-linejoin="round" aria-hidden="true">' +
              '<path d="M3 3v16a2 2 0 0 0 2 2h16"/>' +
              '<path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>';
            nav.appendChild(a);
          }
        } else if (!location.pathname.startsWith('/analitika') && !navigator.webdriver) {
          try {
            navigator.sendBeacon(apiUrl + '/api/v1/hit', location.pathname);
          } catch {}
        }

        // Клик по кнопке скачивания APK — отдельное событие с источником.
        if (!token && !navigator.webdriver) {
          document.addEventListener('click', (e) => {
            const a = e.target instanceof Element ? e.target.closest('a[href*="/app/stuk.apk"]') : null;
            if (!a) return;
            try {
              navigator.sendBeacon(apiUrl + '/api/v1/hit', 'download:' + location.pathname);
            } catch {}
          });
        }
      })();
    </script>
  </body>
</html>
