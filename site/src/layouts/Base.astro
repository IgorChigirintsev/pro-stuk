---
import '../styles/global.css';
import { v } from '../data/assetVersion';
import { SITE_URL, SITE_NAME, API_URL } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  /** Дополнительный JSON-LD (уже сериализованный объект). */
  schema?: object;
  /** Широкий контейнер (статьи с боковыми карточками). */
  wide?: boolean;
  /** Картинка для соцсетей (абсолютный путь от корня сайта). */
  ogImage?: string;
}

const { title, description, schema, wide = false, ogImage = v('/og/default.png') } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- /favicon.ico и /apple-touch-icon.png роботы запрашивают сами, даже если не объявлены:
         без файлов это давало 404 в отчёте Search Console. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="ru_RU" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink text-base">
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-4xl items-center gap-6 px-5 py-4">
        <a href="/" class="flex items-center gap-2 font-bold text-l text-ink no-underline">
          <img src="/icon.png" alt="" width="28" height="28" class="rounded-lg" />
          {SITE_NAME}
        </a>
        <!-- Иконки навигации: подписи в title и aria-label -->
        <div class="ml-auto flex items-center gap-4" data-nav>
          <a href="/simptomy/" class="p-1 text-ink-soft hover:text-accent" aria-label="Симптомы" title="Симптомы">
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M11 2v2"/><path d="M5 2v2"/>
              <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
              <path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>
            </svg>
          </a>
          <a href="/kak-eto-rabotaet/" class="p-1 text-ink-soft hover:text-accent" aria-label="Как это работает" title="Как это работает">
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M12 7v14"/>
              <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
            </svg>
          </a>
          <a href="/stati/" class="p-1 text-ink-soft hover:text-accent" aria-label="Статьи" title="Статьи">
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
              <path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class={`mx-auto px-5 py-10 ${wide ? 'max-w-7xl' : 'max-w-4xl'}`}>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-4xl px-5 py-8 text-s text-ink-soft">
        <p class="mb-3">
          «{SITE_NAME}» даёт вероятностную оценку по симптомам и звуку, а не диагноз.
          Итоговое решение о ремонте принимает механик после осмотра автомобиля.
        </p>
        <p class="flex flex-wrap gap-4">
          <a href="/kak-eto-rabotaet/" class="hover:text-accent">Как это работает</a>
          <a href="/politika/" class="hover:text-accent">Политика конфиденциальности</a>
        </p>
      </div>
    </footer>
    <script is:inline define:vars={{ apiUrl: API_URL }}>
      // Обезличенный счётчик просмотров: без cookies и идентификаторов.
      // Машина владельца (с сохранённым ключом аналитики) не учитывается,
      // вместо этого ей показывается кнопка «Аналитика».
      (() => {
        const token = localStorage.getItem('stuk_admin_token');
        if (token) {
          const nav = document.querySelector('[data-nav]');
          if (nav && !nav.querySelector('[data-analytics]')) {
            const a = document.createElement('a');
            a.href = '/analitika/';
            a.className = 'p-1 text-accent hover:opacity-80';
            a.setAttribute('data-analytics', '');
            a.setAttribute('aria-label', 'Аналитика');
            a.setAttribute('title', 'Аналитика');
            a.innerHTML =
              '<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" ' +
              'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' +
              'stroke-linejoin="round" aria-hidden="true">' +
              '<path d="M3 3v16a2 2 0 0 0 2 2h16"/>' +
              '<path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>';
            nav.appendChild(a);
          }
        } else if (!location.pathname.startsWith('/analitika') && !navigator.webdriver) {
          try {
            navigator.sendBeacon(apiUrl + '/api/v1/hit', location.pathname);
          } catch {}
        }

        // Клик по кнопке скачивания APK — отдельное событие с источником.
        if (!token && !navigator.webdriver) {
          document.addEventListener('click', (e) => {
            const a = e.target instanceof Element ? e.target.closest('a[href*="/app/stuk.apk"]') : null;
            if (!a) return;
            try {
              navigator.sendBeacon(apiUrl + '/api/v1/hit', 'download:' + location.pathname);
            } catch {}
          });
        }
      })();
    </script>
  </body>
</html>
