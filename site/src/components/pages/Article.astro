---
/**
 * Страница статьи. Одна на два языка: русский оригинал и английская версия
 * для pSEO. Отличий по вёрстке между ними нет — отличается только источник
 * подписей и схемы: по-русски картинка идёт с готовыми надписями, на
 * английском — та же схема без надписей с номерами и легендой.
 */
import AppCtaCard from '../AppCtaCard.astro';
import KartaZvuka, { type Zone } from '../KartaZvuka.astro';
import SchemeNumbered from '../SchemeNumbered.astro';
import Base from '../../layouts/Base.astro';
import { v } from '../../data/assetVersion';
import { hubForArticle } from '../../data/hubs';
import { hubText } from '../../data/hubs_i18n';
import { schemaForArticle } from '../../data/schemas';
import { ARTICLE_UI, articlesBase, fmtDate, hubsBase } from '../../i18n/articles';
import { SITE_URL } from '../../../site.config.mjs';

interface Props {
  lang: string;
  /** Слаг статьи на этом языке — он же адрес страницы. */
  slug: string;
  /** Слаг русского оригинала: по нему подбираются раздел и схема узла. */
  ruSlug: string;
  data: {
    title: string;
    metaTitle: string;
    description: string;
    pubDate: string;
    updated?: string;
    faq: { q: string; a: string }[];
    sources: { title: string; url: string }[];
  };
  headings: { depth: number; slug: string; text: string }[];
  related: { title: string; href: string }[];
  /** Адреса этой же статьи на других языках — для hreflang. */
  alts: Record<string, string> | null;
  ogImage: string;
}

const { lang, slug, ruSlug, data, headings, related, alts, ogImage } = Astro.props;

const U = ARTICLE_UI[lang]!;
const isRu = lang === 'ru';
const toc = headings.filter((h) => h.depth === 2);

const hubRu = hubForArticle(ruSlug);
const hub = hubText(lang, hubRu);
const hubHref = `${hubsBase(lang)}/${hub.slug}/`;
const indexHref = `${articlesBase(lang)}/`;
const canonical = `${SITE_URL}${articlesBase(lang)}/${slug}/`;

const schemaHit = schemaForArticle(ruSlug);
/** Нет схемы конкретного узла — показываем схему раздела: лучше, чем пустое место. */
const schemaKey = schemaHit ? `shemy/${schemaHit.file}` : `uzly/${hubRu.slug}`;
const schemaLabel = schemaHit ? schemaHit.label : hubRu.h1.toLowerCase();

const ZONE_BY_HUB: Record<string, Zone> = {
  dvigatel: 'motor',
  podveska: 'koleso',
  tormoza: 'koleso',
  transmissiya: 'dnishche',
  vyhlop: 'zad',
  salon: 'salon',
};
const zone = ZONE_BY_HUB[hubRu.slug] ?? 'motor';
const zoneCaption = U.zones[hubRu.slug] ?? U.zones.dvigatel!;

const brand = isRu ? 'Стук' : 'Stuk';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate,
    dateModified: data.updated ?? data.pubDate,
    mainEntityOfPage: canonical,
    inLanguage: lang,
    author: { '@type': 'Organization', name: brand, url: SITE_URL },
    publisher: { '@type': 'Organization', name: brand, url: SITE_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: brand, item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: U.articles, item: `${SITE_URL}${indexHref}` },
      { '@type': 'ListItem', position: 3, name: hub.short, item: `${SITE_URL}${hubHref}` },
      { '@type': 'ListItem', position: 4, name: data.title, item: canonical },
    ],
  },
];
---

<Base
  title={data.metaTitle}
  description={data.description}
  schema={schema}
  ogImage={ogImage}
  lang={lang}
  alts={alts}
  wide
>
  <div class="lg:grid lg:grid-cols-[16rem_minmax(0,42rem)_18rem] lg:justify-center lg:gap-8">
    <!-- Слева: похожие статьи (липкая, только desktop) -->
    <aside class="hidden lg:block">
      {related.length > 0 && (
        <div class="sticky top-6 rounded-card border border-line bg-surface p-5">
          <p class="font-bold">{U.related}</p>
          <ul class="mt-3 space-y-3">
            {related.map((r) => (
              <li>
                <a href={r.href} class="text-s text-accent no-underline hover:underline">{r.title}</a>
              </li>
            ))}
          </ul>
          <a href={hubHref} class="mt-4 block text-s text-accent no-underline hover:underline">
            {U.allInHub.replace('{hub}', hub.short)}
          </a>
          <a href={indexHref} class="mt-2 block text-s text-ink-soft no-underline hover:text-accent">
            {U.allArticles}
          </a>
        </div>
      )}
    </aside>

    <article>
      <nav class="text-s text-ink-soft" aria-label={U.toc}>
        <a href={isRu ? '/' : `/${lang}/`} class="no-underline hover:text-accent">{brand}</a> ·
        <a href={indexHref} class="no-underline hover:text-accent">{U.articles}</a> ·
        <a href={hubHref} class="no-underline hover:text-accent">{hub.short}</a>
      </nav>

      <h1 class="mt-3 text-2xl font-bold sm:text-3xl">{data.title}</h1>
      <p class="mt-2 text-s text-ink-soft">
        {U.updated} {fmtDate(data.updated ?? data.pubDate, lang)}
      </p>

      <KartaZvuka zone={zone} caption={zoneCaption} class="mt-6" lang={lang} />

      {toc.length > 1 && (
        <nav class="mt-6 rounded-card border border-line bg-surface p-5" aria-label={U.toc}>
          <p class="font-bold">{U.toc}</p>
          <ol class="mt-3 list-decimal space-y-1.5 ps-5 text-s">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-accent no-underline hover:underline">{h.text}</a>
              </li>
            ))}
            {data.faq.length > 0 && (
              <li><a href="#faq" class="text-accent no-underline hover:underline">{U.faq}</a></li>
            )}
          </ol>
        </nav>
      )}

      {isRu ? (
        <figure class="mt-8">
          <img
            src={v(`/${schemaKey.replace('shemy/', 'shemy/podpisi-m/').replace('uzly/', 'uzly/podpisi-m/')}.svg`)}
            alt={`${U.scheme}: ${schemaLabel}`}
            width="400"
            height="438"
            loading="lazy"
            class="w-full rounded-card sm:hidden"
          />
          <img
            src={v(`/${schemaKey.replace('shemy/', 'shemy/podpisi/').replace('uzly/', 'uzly/podpisi/')}.svg`)}
            alt={`${U.scheme}: ${schemaLabel}`}
            width="790"
            height="384"
            loading="lazy"
            class="hidden w-full max-w-2xl rounded-card sm:block"
          />
          <figcaption class="mt-2 text-s text-ink-soft">{U.scheme}: {schemaLabel}</figcaption>
        </figure>
      ) : (
        <SchemeNumbered schemaKey={schemaKey} lang={lang} captionWord={U.scheme} class="mt-8" />
      )}

      <div class="article-body">
        <slot />
      </div>

      <h2 id="faq" class="mt-10 text-xl font-bold" style="scroll-margin-top:1rem">{U.faq}</h2>
      <div class="mt-4 space-y-4">
        {data.faq.map((f) => (
          <details class="rounded-card border border-line bg-surface p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>

      {data.sources.length > 0 && (
        <>
          <h2 class="mt-10 text-xl font-bold">{U.sources}</h2>
          <ul class="mt-3 list-disc space-y-1 ps-5 text-s">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener" target="_blank" class="text-accent">
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-6"><AppCtaCard lang={lang} /></div>
    </aside>
  </div>

  <div class="mt-10 space-y-6 lg:hidden">
    <AppCtaCard lang={lang} />
    {related.length > 0 && (
      <div class="rounded-card border border-line bg-surface p-5">
        <p class="font-bold">{U.related}</p>
        <ul class="mt-3 space-y-3">
          {related.map((r) => (
            <li>
              <a href={r.href} class="text-accent no-underline hover:underline">{r.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Base>
