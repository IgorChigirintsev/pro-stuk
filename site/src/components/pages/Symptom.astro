---
/** Разбор одного симптома. Структура — из русского оригинала (группа, узел
 *  дерева, уровни опасности), тексты — из перевода, если он есть. */
import Base from '../../layouts/Base.astro';
import TrafficLight from '../TrafficLight.astro';
import TreeWidget from '../TreeWidget.tsx';
import DownloadApk from '../DownloadApk.astro';
import KartaZvuka, { type Zone } from '../KartaZvuka.astro';
import type { SymptomPage, SymptomTr } from '../../data/types';
import { DEFAULT_LANG, pathFor, symptomPath, t } from '../../i18n';
import { SITE_URL } from '../../../site.config.mjs';

interface Props {
  page: SymptomPage;
  lang?: string;
  /** Перевод текстов; на русском его нет — берётся оригинал. */
  tr?: SymptomTr;
  /** Статьи по теме есть только в русском кластере. */
  articles?: { slug: string; title: string }[];
}

const { page, lang = DEFAULT_LANG, tr, articles = [] } = Astro.props;
const dict = t(lang);
const L = dict.symptoms;

const h1 = tr?.h1 ?? page.h1;
const intro = tr?.intro ?? page.intro;
const canRide = tr?.canRide ?? page.canRide;
const checks = tr?.checks ?? page.checks;
const appHelp = tr?.appHelp ?? page.appHelp;
const faq = tr?.faq ?? page.faq;
// Опасность не переводится — она в данных; перевод даёт только название и оценку.
const causes = page.causes.map((c, i) => ({
  name: tr?.causes[i]?.name ?? c.name,
  likelihood: tr?.causes[i]?.likelihood ?? c.likelihood,
  urgency: c.urgency,
}));

// Цепочка «Стук → Симптомы → разбор»: без неё в выдаче вместо пути к разделу
// показывается голый адрес. Пустой FAQPage не отдаём — разметка без вопросов
// невалидна.
const schema = [
  ...(faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        inLanguage: lang,
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: dict.brand, item: `${SITE_URL}${pathFor('home', lang)}` },
      {
        '@type': 'ListItem',
        position: 2,
        name: L.h1,
        item: `${SITE_URL}${pathFor('symptoms', lang)}`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: h1,
        item: `${SITE_URL}${symptomPath(page.slug, lang)}`,
      },
    ],
  },
];

/** Зона источника звука по группе симптома — для карты звука. */
const ZONE_BY_GROUP: Record<typeof page.group, { zone: Zone; caption: string }> = {
  dvigatel: { zone: 'motor', caption: L.zoneDvigatel },
  dvizhenie: { zone: 'koleso', caption: L.zoneDvizhenie },
  'tormoza-rul': { zone: 'koleso', caption: L.zoneTormoza },
  podveska: { zone: 'koleso', caption: L.zonePodveska },
};
const { zone, caption: zoneCaption } = ZONE_BY_GROUP[page.group];

// Светофор показываем по самой опасной из перечисленных причин — это данные, не оценка.
const RANK = { ok: 0, warn: 1, stop: 2 } as const;
const worstUrgency = page.causes.reduce(
  (worst, c) => (RANK[c.urgency] > RANK[worst] ? c.urgency : worst),
  'ok' as 'ok' | 'warn' | 'stop',
);
---

<Base
  title={tr?.metaTitle ?? page.metaTitle}
  description={tr?.description ?? page.description}
  schema={schema}
  lang={lang}
  symptomSlug={page.slug}
>
  <article>
    <h1 class="text-2xl font-bold sm:text-3xl">{h1}</h1>

    <KartaZvuka zone={zone} caption={zoneCaption} urgency={worstUrgency} lang={lang} class="mt-6" />

    {intro.map((p) => <p class="mt-4 text-ink-soft">{p}</p>)}

    <h2 class="mt-10 text-xl font-bold">{L.causesH2}</h2>
    <!-- min-w: без него на узком экране колонки сжимаются, а в китайском,
         японском и корейском строка рвётся по любому знаку — выходит столбик
         в один иероглиф. Контейнер прокручивается, так что ничего не теряется. -->
    <div class="mt-4 overflow-x-auto rounded-card border border-line">
      <table class="w-full min-w-[34rem] border-collapse text-start">
        <thead>
          <tr class="bg-surface text-s text-ink-soft">
            <th class="p-3 font-semibold">{L.thCause}</th>
            <th class="p-3 font-semibold">{L.thLikelihood}</th>
            <th class="p-3 font-semibold">{L.thDanger}</th>
          </tr>
        </thead>
        <tbody>
          {causes.map((c) => (
            <tr class="border-t border-line align-top">
              <td class="p-3">{c.name}</td>
              <td class="p-3 text-ink-soft">{c.likelihood}</td>
              <td class="p-3"><TrafficLight urgency={c.urgency} lang={lang} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-10 text-xl font-bold">{L.canRideH2}</h2>
    {canRide.map((p) => <p class="mt-4">{p}</p>)}

    <h2 class="mt-10 text-xl font-bold">{L.checksH2}</h2>
    <ul class="mt-4 list-disc space-y-2 ps-5">
      {checks.map((c) => <li>{c}</li>)}
    </ul>

    <h2 class="mt-10 text-xl font-bold">{L.quizH2}</h2>
    <p class="mt-3 mb-4 text-ink-soft">{L.quizSub}</p>
    <TreeWidget client:visible startNode={page.startNode} lang={lang} ui={dict.quiz} />

    <h2 class="mt-10 text-xl font-bold">{L.appHelpH2}</h2>
    <p class="mt-4">{appHelp}</p>

    <h2 class="mt-10 text-xl font-bold">{L.faqH2}</h2>
    <div class="mt-4 space-y-4">
      {faq.map((f) => (
        <details class="rounded-card border border-line bg-surface p-4">
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-2 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>

    {articles.length > 0 && (
      <>
        <h2 class="mt-10 text-xl font-bold">Статьи по теме</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {articles.map((a) => (
            <li>
              <a
                href={`/stati/${a.slug}/`}
                class="block h-full rounded-card border border-line bg-surface p-4 text-ink no-underline hover:border-accent"
              >
                {a.title}
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    <div class="mt-12">
      <DownloadApk lang={lang} />
    </div>
  </article>
</Base>
