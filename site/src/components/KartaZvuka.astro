---
/**
 * Карта звука: силуэт машины с подсвеченной зоной источника
 * и (если известна) шкалой срочности.
 *
 * Срочность передаём только там, где она берётся из данных
 * (симптом-страницы: максимум по causes). Для pSEO-статей её нет —
 * карта показывает только зону, ничего не выдумывая.
 */
export type Zone = 'motor' | 'koleso' | 'dnishche' | 'zad' | 'salon';

interface Props {
  zone: Zone;
  /** Где искать — короткая подпись под заголовком. */
  caption: string;
  urgency?: 'ok' | 'warn' | 'stop';
  class?: string;
}

const { zone, caption, urgency, class: cls = '' } = Astro.props;

/**
 * Зоны в системе координат силуэта (машина смотрит влево).
 * Точечные узлы — круг, протяжённые тракты (выхлоп, трансмиссия) — капсула:
 * круг на колесе противоречил бы подписи «вдоль днища к корме».
 */
type Spot =
  | { kind: 'circle'; x: number; y: number; r: number }
  | { kind: 'capsule'; x0: number; x1: number; y: number; h: number };

const SPOTS: Record<Zone, Spot> = {
  motor: { kind: 'capsule', x0: 44, x1: 126, y: 142, h: 34 },
  koleso: { kind: 'circle', x: 96, y: 168, r: 40 },
  salon: { kind: 'circle', x: 214, y: 104, r: 40 },
  dnishche: { kind: 'capsule', x0: 128, x1: 268, y: 180, h: 18 },
  zad: { kind: 'capsule', x0: 136, x1: 356, y: 182, h: 18 },
};

const spot = SPOTS[zone];
/** Три контура с затуханием — «эхо» вокруг зоны, одинаково для круга и капсулы. */
const echo = [0, 12, 24];
/** Кадр подрезаем под зону: у салона подсветка уходит выше крыши. */
const viewBox = zone === 'salon' ? '8 32 384 204' : '8 58 384 178';

/** Кузов седана: длинный капот слева, вертикальная корма справа, вырезы арок. */
const BODY =
  'M 24 152 C 24 138 30 131 44 127 L 74 121 L 132 110 L 172 72 L 258 70 ' +
  'L 300 102 L 352 108 C 366 110 374 120 374 136 L 374 158 ' +
  'C 374 165 370 168 364 168 L 330 168 A 34 34 0 0 0 262 168 ' +
  'L 130 168 A 34 34 0 0 0 62 168 L 32 168 C 26 167 24 163 24 158 Z';

const URGENCY: Record<string, { label: string; step: number; color: string }> = {
  ok: { label: 'Можно спокойно доехать до сервиса', step: 0, color: '#15803D' },
  warn: { label: 'Не тянуть: проверить в ближайшие дни', step: 1, color: '#B45309' },
  stop: { label: 'Ехать в сервис, не откладывая', step: 2, color: '#C2410C' },
};
const u = urgency ? URGENCY[urgency] : null;

const INK = '#5C6B78';
const LINE = '#C9D3DA';
const SKIN = '#EAEFF3';
const GLASS = '#F5F7F9';
---

<figure class={`rounded-card border border-line bg-surface p-5 ${cls}`}>
  <p class="font-bold">Откуда звук</p>
  <p class="mt-1 text-s text-ink-soft">{caption}</p>

  <svg
    viewBox={viewBox}
    role="img"
    aria-label={`Силуэт автомобиля, подсвечена зона: ${caption}`}
    class="mt-3 w-full"
  >
    <path d={BODY} fill={SKIN} stroke={INK} stroke-width="3" stroke-linejoin="round" />

    <!-- стёкла: переднее делится стойкой, заднее сужается к корме -->
    <path d="M 142 106 L 176 78 L 210 78 L 210 106 Z" fill={GLASS} stroke={INK} stroke-width="2.2" />
    <path d="M 218 78 L 250 78 L 284 106 L 218 106 Z" fill={GLASS} stroke={INK} stroke-width="2.2" />

    <!-- линия окон, дверной шов и ручки -->
    <path d="M 136 108 L 292 108" stroke={LINE} stroke-width="2" />
    <path d="M 214 108 L 214 166" stroke={LINE} stroke-width="2" />
    <rect x="196" y="118" width="16" height="5" rx="2.5" fill={LINE} />
    <rect x="228" y="118" width="16" height="5" rx="2.5" fill={LINE} />
    <!-- зеркало -->
    <path d="M 140 103 L 128 101 L 129 111 L 140 111 Z" fill={SKIN} stroke={INK} stroke-width="2.2" stroke-linejoin="round" />

    <!-- перёд: фара со скосом, решётка, бампер -->
    <path d="M 34 134 L 58 128 L 61 140 L 37 145 Z" fill={GLASS} stroke={INK} stroke-width="2.4" stroke-linejoin="round" />
    <path d="M 31 153 L 55 149" stroke={INK} stroke-width="2.4" />
    <path d="M 32 160 L 51 157" stroke={LINE} stroke-width="2" />

    <!-- корма: вертикальный фонарь и бампер -->
    <rect x="356" y="116" width="14" height="24" rx="3" fill={GLASS} stroke={INK} stroke-width="2.4" />
    <path d="M 348 152 L 372 152" stroke={INK} stroke-width="2.4" />

    <!-- колёса со спицами -->
    {[96, 296].map((cx) => (
      <>
        <circle cx={cx} cy="168" r="34" fill={SKIN} stroke={INK} stroke-width="3" />
        <circle cx={cx} cy="168" r="21" fill={GLASS} stroke={INK} stroke-width="2.4" />
        {[0, 72, 144, 216, 288].map((a) => (
          <path
            d={`M ${cx + 7 * Math.cos((a * Math.PI) / 180)} ${168 + 7 * Math.sin((a * Math.PI) / 180)} L ${cx + 19 * Math.cos((a * Math.PI) / 180)} ${168 + 19 * Math.sin((a * Math.PI) / 180)}`}
            stroke={LINE}
            stroke-width="2.2"
          />
        ))}
        <circle cx={cx} cy="168" r="6" fill={LINE} />
      </>
    ))}

    <path d="M 18 206 L 382 206" stroke={LINE} stroke-width="2.5" />

    {spot.kind === 'circle'
      ? echo.map((pad, i) => (
          <circle
            cx={spot.x}
            cy={spot.y}
            r={spot.r + pad}
            fill={i === 0 ? 'rgba(14,124,123,0.16)' : 'none'}
            stroke="#0E7C7B"
            stroke-width={[3, 2, 1.6][i]}
            opacity={[1, 0.55, 0.3][i]}
          />
        ))
      : echo.map((pad, i) => (
          <rect
            x={spot.x0 - pad}
            y={spot.y - spot.h / 2 - pad}
            width={spot.x1 - spot.x0 + pad * 2}
            height={spot.h + pad * 2}
            rx={spot.h / 2 + pad}
            fill={i === 0 ? 'rgba(14,124,123,0.16)' : 'none'}
            stroke="#0E7C7B"
            stroke-width={[3, 2, 1.6][i]}
            opacity={[1, 0.55, 0.3][i]}
          />
        ))}
  </svg>

  {u && (
    <div class="mt-4">
      <div class="flex gap-1.5" aria-hidden="true">
        {[0, 1, 2].map((i) => (
          <span
            class="h-2.5 flex-1 rounded-full"
            style={`background:${i === u.step ? u.color : '#C9D3DA'}`}
          />
        ))}
      </div>
      <p class="mt-2 text-s font-bold" style={`color:${u.color}`}>{u.label}</p>
    </div>
  )}
</figure>
