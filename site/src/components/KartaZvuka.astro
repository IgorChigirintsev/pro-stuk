---
/**
 * Карта звука: силуэт машины с подсвеченной зоной источника
 * и (если известна) шкалой срочности.
 *
 * Срочность передаём только там, где она берётся из данных
 * (симптом-страницы: максимум по causes). Для pSEO-статей её нет —
 * карта показывает только зону, ничего не выдумывая.
 */
import { DEFAULT_LANG, t } from '../i18n';

export type Zone = 'motor' | 'koleso' | 'dnishche' | 'zad' | 'salon';

interface Props {
  zone: Zone;
  /** Где искать — короткая подпись под заголовком. */
  caption: string;
  urgency?: 'ok' | 'warn' | 'stop';
  class?: string;
  lang?: string;
}

const { zone, caption, urgency, class: cls = '', lang = DEFAULT_LANG } = Astro.props;
const L = t(lang).symptoms;

/**
 * Зоны в системе координат силуэта (машина смотрит влево).
 * Точечные узлы — круг, протяжённые тракты (выхлоп, трансмиссия) — капсула:
 * круг на колесе противоречил бы подписи «вдоль днища к корме».
 */
type Spot =
  | { kind: 'circle'; x: number; y: number; r: number }
  | { kind: 'capsule'; x0: number; x1: number; y: number; h: number };

const SPOTS: Record<Zone, Spot> = {
  motor: { kind: 'capsule', x0: 44, x1: 124, y: 140, h: 36 },
  koleso: { kind: 'circle', x: 96, y: 169, r: 42 },
  salon: { kind: 'circle', x: 212, y: 98, r: 42 },
  dnishche: { kind: 'capsule', x0: 130, x1: 266, y: 182, h: 18 },
  zad: { kind: 'capsule', x0: 138, x1: 352, y: 184, h: 18 },
};

const spot = SPOTS[zone];
/** Три контура с затуханием — «эхо» вокруг зоны, одинаково для круга и капсулы. */
const echo = [0, 12, 24];
/** Кадр подрезаем под зону: у салона подсветка уходит выше крыши. */
const viewBox = zone === 'salon' ? '8 32 384 204' : '8 58 384 178';

/** Кузов: колёсная база по третям, выраженная оконная линия, вырезы арок. */
const BODY =
  'M 26 150 C 26 136 32 128 46 123 L 74 117 L 128 110 L 170 64 L 258 62 ' +
  'L 302 100 L 350 105 C 366 107 374 117 375 133 L 376 154 ' +
  'C 376 164 371 169 362 169 L 332 169 A 36 36 0 0 0 260 169 ' +
  'L 132 169 A 36 36 0 0 0 60 169 L 34 169 C 28 168 26 163 26 157 Z';

/** Оконный проём с racками стоек: передняя дверь, задняя дверь. */
const GLASS_F = 'M 138 104 L 174 70 L 206 70 L 206 104 Z';
const GLASS_R = 'M 214 70 L 250 70 L 286 104 L 214 104 Z';

const URGENCY: Record<string, { label: string; step: number; color: string }> = {
  ok: { label: L.mapOk, step: 0, color: '#15803D' },
  warn: { label: L.mapWarn, step: 1, color: '#B45309' },
  stop: { label: L.mapStop, step: 2, color: '#C2410C' },
};
const u = urgency ? URGENCY[urgency] : null;

const INK = '#5C6B78';
const LINE = '#C9D3DA';
const SKIN = '#EAEFF3';
const GLASS = '#F5F7F9';
---

<figure class={`rounded-card border border-line bg-surface p-5 ${cls}`}>
  <p class="font-bold">{L.mapTitle}</p>
  <p class="mt-1 text-s text-ink-soft">{caption}</p>

  <svg
    viewBox={viewBox}
    role="img"
    aria-label={`${L.mapTitle}: ${caption}`}
    class="mt-3 w-full"
  >
    <path d={BODY} fill={SKIN} stroke={INK} stroke-width="3" stroke-linejoin="round" />

    <!-- стёкла и стойки -->
    <path d={GLASS_F} fill={GLASS} stroke={INK} stroke-width="2.2" stroke-linejoin="round" />
    <path d={GLASS_R} fill={GLASS} stroke={INK} stroke-width="2.2" stroke-linejoin="round" />

    <!-- оконная линия, швы дверей, ручки, зеркало -->
    <path d="M 132 106 L 294 106" stroke={LINE} stroke-width="2" />
    <path d="M 210 106 L 210 167" stroke={LINE} stroke-width="2" />
    <path d="M 138 110 L 140 166" stroke={LINE} stroke-width="1.6" />
    <path d="M 286 108 L 292 166" stroke={LINE} stroke-width="1.6" />
    <rect x="190" y="118" width="17" height="5" rx="2.5" fill={LINE} />
    <rect x="224" y="118" width="17" height="5" rx="2.5" fill={LINE} />
    <path d="M 134 158 L 258 158" stroke={LINE} stroke-width="1.6" />
    <path d="M 332 156 L 356 155" stroke={LINE} stroke-width="1.6" />
    <path d="M 136 100 L 122 97 L 121 108 L 135 109 Z" fill={SKIN} stroke={INK}
      stroke-width="2.2" stroke-linejoin="round" />

    <!-- перёд: фара с линзой, решётка, бампер -->
    <path d="M 33 128 L 60 121 L 64 134 L 36 140 Z" fill={GLASS} stroke={INK}
      stroke-width="2.4" stroke-linejoin="round" />
    <path d="M 41 129 L 57 125" stroke={LINE} stroke-width="1.6" />
    <path d="M 29 146 L 58 141" stroke={INK} stroke-width="2.4" />
    <path d="M 30 153 L 52 149" stroke={LINE} stroke-width="1.8" />
    <path d="M 27 160 L 46 157" stroke={LINE} stroke-width="1.8" />

    <!-- корма: фонарь с секцией и бампер -->
    <rect x="356" y="112" width="16" height="26" rx="3" fill={GLASS} stroke={INK} stroke-width="2.4" />
    <path d="M 356 126 L 372 126" stroke={LINE} stroke-width="1.6" />
    <path d="M 344 152 L 374 151" stroke={INK} stroke-width="2.4" />

    <!-- колёса: шина, диск со спицами, ступица -->
    {[96, 296].map((cx) => (
      <>
        <circle cx={cx} cy="169" r="36" fill={SKIN} stroke={INK} stroke-width="3" />
        <circle cx={cx} cy="169" r="29" fill="none" stroke={LINE} stroke-width="1.6" />
        <circle cx={cx} cy="169" r="22" fill={GLASS} stroke={INK} stroke-width="2.4" />
        {[0, 72, 144, 216, 288].map((a) => (
          <path
            d={`M ${cx + 7 * Math.cos((a * Math.PI) / 180)} ${169 + 7 * Math.sin((a * Math.PI) / 180)} L ${cx + 20 * Math.cos((a * Math.PI) / 180)} ${169 + 20 * Math.sin((a * Math.PI) / 180)}`}
            stroke={LINE}
            stroke-width="2.2"
          />
        ))}
        <circle cx={cx} cy="169" r="6" fill={LINE} />
      </>
    ))}

    <path d="M 18 208 L 382 208" stroke={LINE} stroke-width="2.5" />

    {spot.kind === 'circle'
      ? echo.map((pad, i) => (
          <circle
            cx={spot.x}
            cy={spot.y}
            r={spot.r + pad}
            fill={i === 0 ? 'rgba(14,124,123,0.16)' : 'none'}
            stroke="#0E7C7B"
            stroke-width={[3, 2, 1.6][i]}
            opacity={[1, 0.55, 0.3][i]}
          />
        ))
      : echo.map((pad, i) => (
          <rect
            x={spot.x0 - pad}
            y={spot.y - spot.h / 2 - pad}
            width={spot.x1 - spot.x0 + pad * 2}
            height={spot.h + pad * 2}
            rx={spot.h / 2 + pad}
            fill={i === 0 ? 'rgba(14,124,123,0.16)' : 'none'}
            stroke="#0E7C7B"
            stroke-width={[3, 2, 1.6][i]}
            opacity={[1, 0.55, 0.3][i]}
          />
        ))}
  </svg>

  {u && (
    <div class="mt-4">
      <div class="flex gap-1.5" aria-hidden="true">
        {[0, 1, 2].map((i) => (
          <span
            class="h-2.5 flex-1 rounded-full"
            style={`background:${i === u.step ? u.color : '#C9D3DA'}`}
          />
        ))}
      </div>
      <p class="mt-2 text-s font-bold" style={`color:${u.color}`}>{u.label}</p>
    </div>
  )}
</figure>
