---
/** Липкая карточка-CTA: ведёт на главную к блоку скачивания приложения. */
import { DEFAULT_LANG, t } from '../i18n';
import StoreBadges from './StoreBadges.astro';

interface Props {
  lang?: string;
}
const { lang = DEFAULT_LANG } = Astro.props;
const d = t(lang);

---

<div class="rounded-card border border-line bg-surface p-5">
  <div class="flex items-center gap-3">
    <img src="/icon-96.png" alt="" width="40" height="40" class="rounded-xl" />
    <p class="font-bold text-l">{d.brand}</p>
  </div>
  <p class="mt-3 text-s text-ink-soft">{d.download.cardLead}</p>
  <ul class="mt-3 space-y-1 text-s text-ink-soft">
    {d.download.cardBullets.map((b) => <li>· {b}</li>)}
  </ul>
  {/* Призыв над значками: без слов рядом неясно, куда они ведут. Сами
      значки — по левому краю, как текст карточки, и прямо в магазин:
      раньше кнопка уводила на главную, и до установки было два перехода. */}
  <p class="mt-4 font-bold">{d.download.tryFree}</p>
  <StoreBadges lang={lang} height={44} class="mt-2" />
</div>
