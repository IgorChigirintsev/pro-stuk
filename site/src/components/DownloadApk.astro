---
/** Блок со значками магазинов. Раньше здесь жило скачивание APK: пока
    приложения не было в магазинах, файл раздавали с сайта. Теперь оно есть
    в обоих, и второй путь установки только путал. */
import { DEFAULT_LANG, t } from '../i18n';
import StoreBadges from './StoreBadges.astro';

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const d = t(lang).download;
---

<section id="skachat" class="rounded-card border border-line bg-surface p-6 sm:p-8">
  <h2 class="text-xl font-bold">{d.h2}</h2>
  <p class="mt-2 text-ink-soft">{d.sub}</p>
  <StoreBadges lang={lang} height={52} class="mt-5" />
  <p class="mt-3 text-s text-ink-soft">{d.playNote}</p>
</section>
