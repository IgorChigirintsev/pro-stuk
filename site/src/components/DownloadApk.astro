---
/** Блок скачивания APK (§8.1). Версия и размер подтягиваются из version.json. */
import { DEFAULT_LANG, t } from '../i18n';
import PlayBadge from './PlayBadge.astro';

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const d = t(lang).download;
---

<section id="skachat" class="rounded-card border border-line bg-surface p-6 sm:p-8">
  <h2 class="text-xl font-bold">{d.h2}</h2>
  <p class="mt-2 text-ink-soft">{d.sub}</p>
  <PlayBadge lang={lang} width={200} class="mt-5" />
  <p class="mt-2 text-s text-ink-soft">{d.playNote}</p>

  {/* APK остаётся для тех, у кого Play нет или не работает. */}
  <a
    href="/app/stuk.apk"
    download
    class="mt-5 inline-block rounded-btn border border-line px-5 py-3 font-semibold text-ink no-underline hover:opacity-70"
  >
    {d.btn}
  </a>
  <p class="mt-2 text-s text-ink-soft" data-apk-meta>&nbsp;</p>

  <details class="mt-4 text-s text-ink-soft">
    <summary class="cursor-pointer font-semibold text-ink">{d.installH}</summary>
    <ol class="mt-2 list-decimal space-y-1 ps-5">
      {d.steps.map((s) => <li>{s}</li>)}
    </ol>
  </details>
</section>

<script is:inline define:vars={{ metaTemplate: d.meta }}>
  // Версия и размер APK — из version.json, который кладёт publish-apk.sh.
  fetch('/app/version.json')
    .then((r) => (r.ok ? r.json() : null))
    .then((v) => {
      if (!v) return;
      const text = metaTemplate
        .replace('{version}', v.version)
        .replace('{size}', v.size_mb)
        .replace('{date}', v.updated);
      for (const el of document.querySelectorAll('[data-apk-meta]')) {
        el.textContent = text;
      }
    })
    .catch(() => {});
</script>
