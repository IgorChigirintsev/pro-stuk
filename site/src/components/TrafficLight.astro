---
/** Мини-светофор для таблиц причин: точка + подпись. */
import { DEFAULT_LANG, t } from '../i18n';

interface Props {
  urgency: 'ok' | 'warn' | 'stop';
  lang?: string;
}
const { urgency, lang = DEFAULT_LANG } = Astro.props;
const s = t(lang).symptoms;
const label = { ok: s.lightOk, warn: s.lightWarn, stop: s.lightStop }[urgency];
const dot = { ok: 'bg-ok', warn: 'bg-warn', stop: 'bg-stop' }[urgency];
---

<span class="inline-flex items-center gap-2 whitespace-nowrap text-s">
  <span class={`inline-block h-3 w-3 rounded-full ${dot}`}></span>{label}
</span>
