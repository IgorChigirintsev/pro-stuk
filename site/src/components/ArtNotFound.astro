---
/**
 * Картинка страницы 404: машина издаёт звук, телефон его ловит.
 * Ровно то, чем занимается «Стук», — поэтому на пустой странице она
 * объясняет продукт лучше, чем извинение за ошибку.
 *
 * Декоративная: текст рядом говорит всё то же словами, а подпись на картинке
 * пришлось бы переключать вместе с языком страницы.
 */
import { ACCENT, CAR_BODY, CAR_GLASS_F, CAR_GLASS_R, GLASS, INK, LINE, SKIN } from '../data/car';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

/** Силуэт нарисован смотрящим влево; здесь разворачиваем его капотом к телефону. */
const CAR = 'translate(288 52) scale(-0.72 0.72)';
/** Колёса силуэта в его собственных координатах — пересчитываем в координаты сцены. */
const wheel = (cx: number) => ({ x: 288 - 0.72 * cx, y: 52 + 0.72 * 169, r: 36 * 0.72 });
const wheels = [wheel(96), wheel(296)];

/** Звук идёт от капота: три дуги с затуханием, раскрытые в сторону телефона. */
const NOSE = { x: 272, y: 150 };
const waves = [
  { r: 15, w: 3.2, o: 1 },
  { r: 27, w: 3.2, o: 0.7 },
  { r: 39, w: 3.2, o: 0.4 },
];
const arc = (r: number) =>
  `M ${NOSE.x + r * Math.cos((-52 * Math.PI) / 180)} ${NOSE.y + r * Math.sin((-52 * Math.PI) / 180)} ` +
  `A ${r} ${r} 0 0 1 ${NOSE.x + r * Math.cos((52 * Math.PI) / 180)} ${NOSE.y + r * Math.sin((52 * Math.PI) / 180)}`;
---

<!-- Фон и скруглённые углы рисует контейнер: своя подложка внутри svg
     растягивалась вместе с ним, и её радиус переставал совпадать с рамкой. -->
<!-- Кадр подрезан под сцену: сверху и снизу иначе остаётся пустая треть. -->
<svg viewBox="0 52 400 172" class={cls} aria-hidden="true" focusable="false">
  <!-- машина: тот же силуэт, что на карте звука в разборах -->
  <g transform={CAR}>
    <path d={CAR_BODY} fill={SKIN} stroke={INK} stroke-width="3" stroke-linejoin="round" />
    <path d={CAR_GLASS_F} fill={GLASS} stroke={INK} stroke-width="2.2" stroke-linejoin="round" />
    <path d={CAR_GLASS_R} fill={GLASS} stroke={INK} stroke-width="2.2" stroke-linejoin="round" />
    <path d="M 132 106 L 294 106" stroke={LINE} stroke-width="2" />
    <path d="M 210 106 L 210 167" stroke={LINE} stroke-width="2" />
    <path d="M 33 128 L 60 121 L 64 134 L 36 140 Z" fill={GLASS} stroke={INK} stroke-width="2.4" stroke-linejoin="round" />
    <path d="M 29 146 L 58 141" stroke={INK} stroke-width="2.4" />
  </g>

  {
    wheels.map(({ x, y, r }) => (
      <>
        <circle cx={x} cy={y} r={r} fill={SKIN} stroke={INK} stroke-width="3" />
        <circle cx={x} cy={y} r={r * 0.6} fill={GLASS} stroke={INK} stroke-width="2.2" />
        <circle cx={x} cy={y} r={4} fill={LINE} />
      </>
    ))
  }

  <path d="M 14 206 L 386 206" stroke={LINE} stroke-width="2.5" stroke-linecap="round" />

  <!-- звук от капота -->
  {
    waves.map(({ r, w, o }) => (
      <path d={arc(r)} fill="none" stroke={ACCENT} stroke-width={w} stroke-linecap="round" opacity={o} />
    ))
  }

  <!-- телефон: микрофоном к машине, на экране растёт дорожка записи -->
  <g transform="rotate(-9 350 138)">
    <rect x="320" y="76" width="60" height="124" rx="12" fill={SKIN} stroke={INK} stroke-width="3" />
    <rect x="327" y="88" width="46" height="100" rx="6" fill="#FFFFFF" stroke={LINE} stroke-width="1.8" />
    <circle cx="350" cy="82" r="2.6" fill={LINE} />
    <circle cx="350" cy="194" r="2.6" fill={LINE} />
    {
      [
        { x: 334, h: 14 },
        { x: 341, h: 30 },
        { x: 348, h: 46 },
        { x: 355, h: 26 },
        { x: 362, h: 12 },
      ].map(({ x, h }) => (
        <rect x={x} y={138 - h / 2} width="4" height={h} rx="2" fill={ACCENT} />
      ))
    }
  </g>
</svg>
